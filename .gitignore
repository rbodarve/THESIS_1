# ============================================================
#  THESIS_1 — .gitignore
#  Keep code, configs, metrics and result plots in the repo;
#  keep large datasets, trained weights and raw image dumps OUT.
#  NOTE: gitignore has no inline comments — every comment is on
#  its own line, otherwise the pattern silently breaks.
# ============================================================

# ----- Datasets & raw data -----
lstm_nsfw/dataset.csv
*.tfrecord
# Numpy arrays (calibration / sample data) — but keep the small
# quantization calibration set the YOLO export needs.
*.npy
!yolov10nver6/calibration_image_sample_data_20x128x128x3_float32.npy

# ----- Trained model weights / exported artifacts -----
*.pt
*.keras
*.h5
*.ckpt
*.onnx
*.tflite
# SavedModel / frozen graphs (saved_model.pb, fingerprint.pb)
*.pb
*.pickle
*.pkl
*.joblib

# TensorFlow SavedModel variable shards
**/variables/
**/*.index
**/*.data-00000-of-00001

# ----- Raw image dumps (may contain dataset / NSFW imagery) -----
# Ultralytics training/validation batch previews
**/train_batch*.jpg
**/val_batch*.jpg
# Per-image inference outputs
yolov10nver6/output/inference_results/

# NOTE: result plots (curves, confusion matrices, results.png,
# labels.jpg, training_history.png) are intentionally NOT ignored
# — they document thesis results and are small.

# ============================================================
#  Standard Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# ============================================================
#  Tooling / OS
# ============================================================
# Local Claude Code settings (machine-specific)
.claude/settings.local.json
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
